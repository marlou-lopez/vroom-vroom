# Copy to .env in backend/ (git-ignored). Every setting is RACECOACH_<NAME>.

# LLM provider: openai (default), anthropic, gemini or ollama.
RACECOACH_LLM_PROVIDER=openai
# Strong model (Analyze, Corner) and fast model (Average). OpenAI and Anthropic have defaults
# (gpt-6.1-terra / gpt-6-luna, claude-sonnet-5-5 / claude-haiku-5-5); gemini and ollama need both.
# RACECOACH_LLM_STRONG=
# RACECOACH_LLM_FAST=
# An OpenAI-compatible host (OpenRouter, Groq, DeepSeek). ollama defaults to http://127.0.0.1:11434/v1.
# Calls through a custom base URL or ollama are not priced.
# RACECOACH_LLM_BASE_URL=

# The key for the chosen provider (the provider's usual variable also works, e.g. OPENAI_API_KEY).
# RACECOACH_OPENAI_API_KEY=
# RACECOACH_ANTHROPIC_API_KEY=
# RACECOACH_GEMINI_API_KEY=

# Folder the watcher polls for finished LMU recordings.
# RACECOACH_LMU_TELEMETRY_DIR=
